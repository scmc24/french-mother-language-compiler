mbɔmbɔ
    ndambo a;
    ndambo b;
    ndambo choix;
    ndambo resultat;
    
    yɛnɛ a;
    yɛnɛ b;
    yɛnɛ choix;
    
    sɔ (choix == 1) tɛ
        resultat <- a + b;
    sukasɔ
    
    sɔ (choix == 2) tɛ
        resultat <- a - b;
    sukasɔ
    
    sɔ (choix == 3) tɛ
        resultat <- a * b;
    sukasɔ
    
    kɔma resultat;
suka