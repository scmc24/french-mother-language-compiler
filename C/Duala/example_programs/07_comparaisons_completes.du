mbɔmbɔ
    ndambo a;
    ndambo b;
    
    kɔma "Tɔlɛ deux nombres entiers :\n";
    yɛnɛ a;
    yɛnɛ b;
    
    // Test de l'égalité (==)
    kɔma "Test ", a, " == ", b, " : ";
    sɔ (a == b) tɛ
        kɔma "vrai\n";
    kɛma
        kɔma "faux\n";
    sukasi
    
    // Test de l'inégalité (!=)
    kɔma "Test ", a, " != ", b, " : ";
    sɔ (a != b) tɛ
        kɔma "vrai\n";
    kɛma
        kɔma "faux\n";
    sukasi
    
    // Test de l'infériorité stricte (<)
    kɔma "Test ", a, " < ", b, " : ";
    sɔ (a < b) tɛ
        kɔma "vrai\n";
    kɛma
        kɔma "faux\n";
    sukasi
    
    // Test de la supériorité stricte (>)
    kɔma "Test ", a, " > ", b, " : ";
    sɔ (a > b) tɛ
        kɔma "vrai\n";
    kɛma
        kɔma "faux\n";
    sukasi
    
    // Test de l'infériorité ou égalité (<=)
    kɔma "Test ", a, " <= ", b, " : ";
    sɔ (a <= b) tɛ
        kɔma "vrai\n";
    kɛma
        kɔma "faux\n";
    sukasi
    
    // Test de la supériorité ou égalité (>=)
    kɔma "Test ", a, " >= ", b, " : ";
    sɔ (a >= b) tɛ
        kɔma "vrai\n";
    kɛma
        kɔma "faux\n";
    sukasi
suka
