mbɔmbɔ
    ndambo a;
    ndambo b;
    ndambo c;
    ndambo carre_a;
    ndambo carre_b;
    ndambo carre_c;
    
    yɛnɛ a;
    yɛnɛ b;
    yɛnɛ c;
    
    carre_a <- a * a;
    carre_b <- b * b;
    carre_c <- c * c;
    
    sɔ (carre_a + carre_b == carre_c) tɛ
        kɔma 1;
    sɔnon
        kɔma 0;
    sukasɔ
suka
