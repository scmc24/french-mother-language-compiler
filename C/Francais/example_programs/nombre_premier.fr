debut
    entier nombre;
    entier i;
    entier divisible;
    
    lire nombre;
    i <- 2;
    divisible <- 0;
    
    tant_que (i < nombre) faire
        si ((nombre / i) * i == nombre) alors
            divisible <- 1;
        finsi
        i <- i + 1;
    fintant
    
    si (divisible == 0) alors
        ecrire 1;
    sinon
        ecrire 0;
    finsi
fin
