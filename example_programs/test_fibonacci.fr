debut
    entier a;
    entier b;
    entier c;
    entier n;
    entier i;
    
    lire n;
    
    a <- 0;
    b <- 1;
    i <- 0;
    
    ecrire a;
    ecrire b;
    
    tant_que (i < n) faire
        c <- a + b;
        ecrire c;
        a <- b;
        b <- c;
        i <- i + 1;
    fintant
fin