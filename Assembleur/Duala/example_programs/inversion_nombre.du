mbɔmbɔ
    ndambo nombre;
    ndambo inverse;
    ndambo chiffre;
    
    yɛnɛ nombre;
    inverse <- 0;
    
    mbɛlɛ (nombre > 0) sala
        chiffre <- nombre - (nombre / 10) * 10;
        inverse <- inverse * 10 + chiffre;
        nombre <- nombre / 10;
    sukatant
    
    kɔma inverse;
suka
