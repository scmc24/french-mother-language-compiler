debut
    entier c;
    entier b;
    entier choix;
    entier resultat;
    
    lire c;
    lire b;
    lire choix;
    
    si (choix == 1) alors
        resultat <- c + b;
    finsi
    
    si (choix == 2) alors
        resultat <- c - b;
    finsi
    
    si (choix == 3) alors
        resultat <- c * b;
    finsi
    
    ecrire resultat;
fin