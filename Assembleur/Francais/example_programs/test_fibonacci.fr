debut
    entier d;
    entier b;
    entier c;
    entier n;
    entier i;
    
    lire n;
    
    d <- 0;
    b <- 1;
    i <- 0;
    
    ecrire d;
    ecrire b;
    
    tant_que (i < n) faire
        c <- d + b;
        ecrire c;
        d <- b;
        b <- c;
        i <- i + 1;
    fintant
fin