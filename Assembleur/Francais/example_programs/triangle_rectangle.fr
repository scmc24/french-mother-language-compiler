debut
    entier d;
    entier b;
    entier c;
    entier carre_a;
    entier carre_b;
    entier carre_c;
    
    lire d;
    lire b;
    lire c;
    
    carre_a <- d * d;
    carre_b <- b * b;
    carre_c <- c * c;
    
    si (carre_a + carre_b == carre_c) alors
        ecrire 1;
    sinon
        ecrire 0;
    finsi
fin
